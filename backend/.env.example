# Ministry of Tribal Affairs - ST Scholarship Platform Environment Configuration
PROJECT_NAME="Ministry of Tribal Affairs - ST Scholarship Portal"
SECRET_KEY=replace-with-your-strong-secret-key-in-production
DATABASE_URL=sqlite:///./scholarship_portal.db

# DigiLocker Mode ('demo' for sandbox simulation, 'production' for live MeriPehchaan OAuth2)
DIGILOCKER_MODE=demo
DIGILOCKER_CLIENT_ID=mota_scholarship_portal
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/digilocker/callback

# Carrier SMS Gateway (Fast2SMS)
FAST2SMS_API_KEY=

# Global SMS Gateway (Twilio - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
